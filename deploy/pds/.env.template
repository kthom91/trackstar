# ==============================================================================
# TrackStar AT Protocol PDS - Production Environment Configuration
# ==============================================================================

# Public Hostname of your PDS (e.g. pds.yourdomain.com)
PDS_HOSTNAME=pds.yourdomain.com

# Public Base URL (https is required for production ATProto federation)
PDS_PUBLIC_URL=https://pds.yourdomain.com

# Admin password for PDS management (creating accounts, invite codes)
# Generate a strong password: openssl rand -hex 16
PDS_ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# JWT Secret for session signing (32-byte hex string)
# Generate with: openssl rand -hex 32
PDS_JWT_SECRET=change_this_to_a_random_32_byte_hex_string

# K256 private key for PLC directory operations (32-byte / 64-character hex string)
# Generate with: openssl ecparam --name secp256k1 --genkey --noout --outform DER | tail -c +8 | head -c 32 | xxd -p -c 32
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=change_this_to_a_valid_secp256k1_hex_key

# Require invite codes to register accounts on this PDS (recommended: true)
PDS_INVITE_REQUIRED=true

# Blob upload limit in bytes (default: 50MB)
PDS_BLOB_UPLOAD_LIMIT=52428800

# Upstream AT Protocol network services (Production Bluesky Network)
PDS_DID_PLC_URL=https://plc.directory
PDS_BSKY_APP_VIEW_URL=https://api.bsky.app
PDS_BSKY_APP_VIEW_DID=did:web:api.bsky.app
PDS_REPORT_SERVICE_URL=https://mod.bsky.app
PDS_REPORT_SERVICE_DID=did:plc:ar7c4by46qzaona2a2vptpon
PDS_CRAWLERS=https://bsky.network

# Logging
LOG_ENABLED=true
