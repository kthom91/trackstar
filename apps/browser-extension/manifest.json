{
  "manifest_version": 3,
  "name": "Trackstar — Media PDS Sync",
  "version": "1.3.0",
  "description": "1-click sync helper for Letterboxd, StoryGraph, and AT Protocol PDS.",
  "permissions": [
    "storage",
    "identity",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://letterboxd.com/*",
    "https://*.letterboxd.com/*",
    "https://app.thestorygraph.com/*",
    "https://*.thestorygraph.com/*",
    "https://api.setlist.fm/*",
    "https://*.setlist.fm/*",
    "https://storage.googleapis.com/*",
    "http://localhost:3000/*",
    "https://*.bsky.social/*",
    "https://*.bsky.network/*",
    "https://plc.directory/*",
    "https://*.atproto.host/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Trackstar PDS Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://letterboxd.com/*",
        "https://*.letterboxd.com/*"
      ],
      "js": [
        "content_scripts/letterboxd.js"
      ],
      "css": [
        "content_scripts/letterboxd.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.thestorygraph.com/*",
        "https://*.thestorygraph.com/*"
      ],
      "js": [
        "content_scripts/storygraph.js"
      ],
      "css": [
        "content_scripts/storygraph.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
