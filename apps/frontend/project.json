{
  "name": "frontend",
  "projectType": "application",
  "sourceRoot": "apps/frontend/src",
  "tags": ["type:app", "platform:web"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng build",
        "cwd": "apps/frontend"
      },
      "configurations": {
        "production": {
          "command": "ng build --configuration production"
        },
        "development": {
          "command": "ng build --configuration development"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng serve",
        "cwd": "apps/frontend"
      },
      "configurations": {
        "production": {
          "command": "ng serve --configuration production"
        }
      }
    }
  }
}
