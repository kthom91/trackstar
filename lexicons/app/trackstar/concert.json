{
  "lexicon": 1,
  "id": "app.trackstar.concert",
  "defs": {
    "main": {
      "type": "record",
      "description": "A user's logged concert.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["artist", "date", "loggedAt"],
        "properties": {
          "artist": { "type": "string" },
          "tour": { "type": "string" },
          "venue": { "type": "string" },
          "city": { "type": "string" },
          "date": { "type": "string", "format": "datetime" },
          "imageUrl": { "type": "string", "format": "uri" },
          "status": { "type": "string", "knownValues": ["want_to_consume", "completed"] },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
          "review": { "type": "string" },
          "loggedAt": { "type": "string", "format": "datetime" },
          "source": { "type": "string" },
          "sourceUrl": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
