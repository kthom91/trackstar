{
  "lexicon": 1,
  "id": "app.trackstar.book",
  "defs": {
    "main": {
      "type": "record",
      "description": "A user's logged book.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["title", "status", "loggedAt"],
        "properties": {
          "title": { "type": "string" },
          "author": { "type": "string" },
          "year": { "type": "integer" },
          "isbn": { "type": "string" },
          "coverUrl": { "type": "string", "format": "uri" },
          "status": { "type": "string", "knownValues": ["want_to_consume", "consuming", "completed", "dropped"] },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
          "review": { "type": "string" },
          "loggedAt": { "type": "string", "format": "datetime" },
          "completedAt": { "type": "string", "format": "datetime" },
          "source": { "type": "string" },
          "sourceUrl": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
