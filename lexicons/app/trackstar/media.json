{
  "lexicon": 1,
  "id": "app.trackstar.media",
  "defs": {
    "main": {
      "type": "record",
      "description": "A media item tracked in TrackStar.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["id", "mediaType", "title", "createdAt"],
        "properties": {
          "id": { 
            "type": "string", 
            "description": "External ID, e.g., isbn:9780593135204, tmdb:671, setlist:12345" 
          },
          "mediaType": { 
            "type": "string", 
            "knownValues": ["book", "movie", "concert"] 
          },
          "title": { 
            "type": "string" 
          },
          "metadataJson": { 
            "type": "string", 
            "description": "JSON string of additional metadata" 
          },
          "createdAt": { 
            "type": "string", 
            "format": "datetime" 
          }
        }
      }
    }
  }
}