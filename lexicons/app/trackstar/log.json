{
  "lexicon": 1,
  "id": "app.trackstar.log",
  "defs": {
    "main": {
      "type": "record",
      "description": "A user's log of consuming a media item.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["mediaItemId", "status", "loggedAt"],
        "properties": {
          "mediaItemId": { 
            "type": "string", 
            "description": "The external ID or AT URI of the media item" 
          },
          "status": { 
            "type": "string", 
            "knownValues": ["want_to_consume", "consuming", "completed"] 
          },
          "rating": { 
            "type": "integer", 
            "minimum": 1, 
            "maximum": 5 
          },
          "review": { 
            "type": "string" 
          },
          "loggedAt": { 
            "type": "string", 
            "format": "datetime" 
          },
          "completedAt": { 
            "type": "string", 
            "format": "datetime" 
          }
        }
      }
    }
  }
}