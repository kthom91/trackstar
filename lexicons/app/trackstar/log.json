{
  "lexicon": 1,
  "id": "app.trackstar.log",
  "defs": {
    "main": {
      "type": "record",
      "description": "A user's self-contained media consumption log and review.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["mediaType", "title", "status", "loggedAt"],
        "properties": {
          "mediaType": {
            "type": "string",
            "knownValues": ["book", "movie", "concert", "music", "game", "other"],
            "description": "The type of media being logged."
          },
          "title": {
            "type": "string",
            "description": "Title of the media item."
          },
          "status": {
            "type": "string",
            "knownValues": ["want_to_consume", "consuming", "completed", "dropped"],
            "description": "User consumption lifecycle status."
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "User rating out of 5."
          },
          "review": {
            "type": "string",
            "description": "User review notes or commentary."
          },
          "loggedAt": {
            "type": "string",
            "format": "datetime",
            "description": "Timestamp when this record was logged."
          },
          "completedAt": {
            "type": "string",
            "format": "datetime",
            "description": "Timestamp when consumption completed."
          },
          "startedAt": {
            "type": "string",
            "format": "datetime",
            "description": "Timestamp when consumption started."
          },
          "source": {
            "type": "string",
            "description": "Originating source or integration provider (e.g. trackstar, letterboxd, storygraph, setlistfm)."
          },
          "metadata": {
            "type": "unknown",
            "description": "Rich media metadata (author, director, year, coverUrl/poster_url, venue, city, identifiers, external URLs)."
          },
          "metadataJson": {
            "type": "unknown",
            "description": "Alias for metadata object for backwards compatibility."
          },
          "mediaItemId": {
            "type": "string",
            "description": "Legacy media item identifier for backwards compatibility."
          }
        }
      }
    }
  }
}