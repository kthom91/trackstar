meta {
  name: 2. Resolve Handle
  type: http
  seq: 2
}

get {
  url: {{pds_url}}/xrpc/com.atproto.identity.resolveHandle?handle={{handle}}
  body: none
  auth: none
}

params:query {
  handle: {{handle}}
}

docs {
  Resolves an AT Protocol handle to its corresponding DID (Decentralized Identifier).
}
