meta {
  name: 8. Purge All TrackStar Records (1-Click Clear)
  type: http
  seq: 4
}

post {
  url: {{pds_url}}/xrpc/com.atproto.repo.applyWrites
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessJwt}}
}

body:json {
  {
    "repo": "{{did}}",
    "writes": []
  }
}

script:pre-request {
  const axios = require('axios');
  const pdsUrl = bru.getEnvVar('pds_url') || 'http://localhost:3000';
  const did = bru.getVar('did') || bru.getEnvVar('did');
  const jwt = bru.getVar('accessJwt') || bru.getEnvVar('accessJwt');
  
  if (did && jwt) {
    const writes = [];
    // Strictly limited to TrackStar collections — Bluesky posts, profile, follows, etc. are untouched!
    const trackstarCollections = ['app.trackstar.log', 'app.trackstar.media'];
  
    for (const coll of trackstarCollections) {
      let cursor = null;
      do {
        try {
          const url = `${pdsUrl}/xrpc/com.atproto.repo.listRecords?repo=${encodeURIComponent(did)}&collection=${coll}&limit=100${cursor ? `&cursor=${encodeURIComponent(cursor)}` : ''}`;
          const res = await axios.get(url, {
            headers: { Authorization: `Bearer ${jwt}` }
          });
          const records = res.data?.records || [];
          records.forEach(r => {
            const rkey = r.uri.split('/').pop();
            writes.push({
              "$type": "com.atproto.repo.applyWrites#delete",
              "collection": coll,
              "rkey": rkey
            });
          });
          cursor = res.data?.cursor;
          if (records.length === 0 || writes.length >= 200) break;
        } catch (e) {
          console.warn('Error listing ' + coll, e?.message || e);
          break;
        }
      } while (cursor && writes.length < 200);
    }
  
    req.setBody({
      repo: did,
      writes: writes.slice(0, 200)
    });
  }
}

docs {
  ### Safe TrackStar Purge
  This request **strictly deletes TrackStar records** (`app.trackstar.log` and `app.trackstar.media`).
  
  It **will NOT touch** any Bluesky posts (`app.bsky.feed.post`), profile (`app.bsky.actor.profile`), follows, likes, or other AT Protocol records in your repository.
}
