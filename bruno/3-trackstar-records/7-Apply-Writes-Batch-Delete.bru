meta {
  name: 7. Apply Writes (Batch Delete / Modify)
  type: http
  seq: 7
}

post {
  url: {{pds_url}}/xrpc/com.atproto.repo.applyWrites
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessJwt}}
}

body:json {
  {
    "repo": "{{did}}",
    "writes": [
      {
        "$type": "com.atproto.repo.applyWrites#delete",
        "collection": "app.trackstar.log",
        "rkey": "example_rkey_1"
      },
      {
        "$type": "com.atproto.repo.applyWrites#delete",
        "collection": "app.trackstar.media",
        "rkey": "example_rkey_2"
      }
    ]
  }
}

docs {
  Executes atomic batch operations on your repository using AT Protocol's `com.atproto.repo.applyWrites`.
  Supports up to 200 create, update, and delete actions in a single atomic transaction.
}
