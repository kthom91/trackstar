meta {
  name: 2. Put TrackStar Media Record
  type: http
  seq: 2
}

post {
  url: {{pds_url}}/xrpc/com.atproto.repo.putRecord
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessJwt}}
}

body:json {
  {
    "repo": "{{did}}",
    "collection": "app.trackstar.media",
    "rkey": "book_dune_test",
    "record": {
      "$type": "app.trackstar.media",
      "id": "book:dune_test",
      "mediaType": "book",
      "title": "Dune",
      "metadataJson": {
        "author": "Frank Herbert",
        "isbn": "9780441013593",
        "coverUrl": "https://covers.openlibrary.org/b/isbn/9780441013593-M.jpg"
      },
      "createdAt": "2026-08-14T00:00:00Z"
    }
  }
}

docs {
  Creates or updates a media catalog record in `app.trackstar.media`.
}
