{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "apps",
  "projects": {
    "frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "inlineTemplate": false,
          "inlineStyle": false,
          "style": "css",
          "skipTests": true
        }
      },
      "root": "apps/frontend",
      "sourceRoot": "apps/frontend/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/frontend",
            "index": "apps/frontend/src/index.html",
            "browser": "apps/frontend/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "apps/frontend/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "packages/assets/icons",
                "output": "assets/icons"
              },
              {
                "glob": "favicon.ico",
                "input": "packages/assets/icons",
                "output": "."
              },
              {
                "glob": "favicon.svg",
                "input": "packages/assets/icons",
                "output": "."
              },
              {
                "glob": "favicon-*.png",
                "input": "packages/assets/icons",
                "output": "."
              },
              {
                "glob": "apple-touch-icon.png",
                "input": "packages/assets/icons",
                "output": "."
              },
              {
                "glob": "icon-*.png",
                "input": "packages/assets/icons",
                "output": "."
              },
              {
                "glob": "icon.svg",
                "input": "packages/assets/icons",
                "output": "."
              },
              {
                "glob": "icon*.png",
                "input": "packages/assets/icons",
                "output": "."
              },
              {
                "glob": "client-metadata.json",
                "input": "apps/frontend/src",
                "output": "."
              }
            ],
            "styles": [
              "apps/frontend/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "3mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kb",
                  "maximumError": "8kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "host": "0.0.0.0",
            "port": 4200
          },
          "configurations": {
            "production": {
              "buildTarget": "frontend:build:production"
            },
            "development": {
              "buildTarget": "frontend:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "browser-extension": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "inlineTemplate": false,
          "inlineStyle": false,
          "style": "css",
          "skipTests": true
        }
      },
      "root": "apps/browser-extension",
      "sourceRoot": "apps/browser-extension/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": {
              "base": "dist/browser-extension",
              "browser": ""
            },
            "index": "apps/browser-extension/src/index.html",
            "browser": "apps/browser-extension/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "apps/browser-extension/tsconfig.app.json",
            "assets": [
              {
                "glob": "manifest.json",
                "input": "apps/browser-extension",
                "output": "."
              },
              {
                "glob": "**/*",
                "input": "packages/assets/icons",
                "output": "icons"
              },
              {
                "glob": "**/*",
                "input": "apps/browser-extension/background",
                "output": "background"
              },
              {
                "glob": "**/*",
                "input": "apps/browser-extension/content_scripts",
                "output": "content_scripts"
              }
            ],
            "styles": [
              "apps/browser-extension/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              },
              "extractLicenses": false,
              "sourceMap": false,
              "outputHashing": "none"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputHashing": "none"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
